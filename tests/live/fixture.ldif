# Test data for the live OpenLDAP tier (tests/live). Modeled on the public
# Forumsys test server (dc=example,dc=com, read-only-admin, scientists),
# plus a multi-valued / non-ASCII entry. Passwords are the literal test
# value 'password' — this directory exists only for CI.

dn: dc=example,dc=com
objectClass: dcObject
objectClass: organization
o: Example
dc: example

dn: cn=read-only-admin,dc=example,dc=com
objectClass: simpleSecurityObject
objectClass: organizationalRole
cn: read-only-admin
userPassword: password

